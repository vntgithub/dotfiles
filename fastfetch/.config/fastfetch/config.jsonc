// Catppuccin Mocha — keys/icons use mauve to match tmux/lualine
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "type": "auto",
        "width": 12,
        "color": {
            "1": "#cba6f7"
        },
        "padding": {
            "top": 3,
            "right": 4,
            "left": 1
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#cba6f7",
            "title": "#cdd6f4",
            "output": "#cdd6f4",
            "separator": "#6c7086"
        }
    },
    "modules": [
        {
            "key": "{#separator}╭───────────╮",
            "type": "custom"
        },
        {
            "key": "{#separator}│ {#keys} user    {#separator}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "{#separator}│ {#keys}󰇅 hname   {#separator}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "type": "command",
            "key": "{#separator}│ {#keys}󱦟 os age  {#separator}│",
            "text": "printf \"%s days\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "{#separator}│ {#keys}󰅐 uptime  {#separator}│",
            "type": "uptime"
        },
        {
            "key": "{#separator}│ {#keys}{icon} distro  {#separator}│",
            "type": "os"
        },
        {
            "key": "{#separator}│ {#keys} kernel  {#separator}│",
            "type": "kernel"
        },
        {
            "key": "{#separator}│ {#keys} wm      {#separator}│",
            "type": "wm"
        },
        {
            "key": "{#separator}│ {#keys}󰇄 desktop {#separator}│",
            "type": "de"
        },
        {
            "key": "{#separator}│ {#keys} term    {#separator}│",
            "type": "terminal"
        },
        {
            "key": "{#separator}│ {#keys} shell   {#separator}│",
            "type": "shell"
        },
        {
            "key": "{#separator}│ {#keys}󰍛 cpu     {#separator}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#separator}│ {#keys}󰉉 disk    {#separator}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#separator}│ {#keys} memory  {#separator}│",
            "type": "memory"
        },
        {
            "key": "{#separator}├───────────┤",
            "type": "custom"
        },
        {
            "key": "{#separator}│ {#keys} colors  {#separator}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "{#separator}╰───────────╯",
            "type": "custom"
        }
    ]
}
